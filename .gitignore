# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# IDEs and editors
.idea/
*.sublime-workspace
.history/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# System files
.DS_Store
Thumbs.db

# Environment files (keep .example files)
.env
.env.local
.env.*.local
!*.example
