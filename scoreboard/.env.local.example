# Vercel AI Gateway key (get one at https://vercel.com > AI Gateway > API Keys)
AI_GATEWAY_API_KEY=

# Optional: override the default model (routed through the gateway)
# SCOREBOARD_MODEL=google/gemini-3.6-flash

# MongoDB connection (e.g. MongoDB Atlas). Required for persistence.
MONGODB_URI=
# Optional: database name (defaults to "scoreboard")
# MONGODB_DB=scoreboard
